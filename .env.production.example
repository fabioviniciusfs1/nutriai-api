# Copie para .env.production na VPS (fica fora do git) e preencha.

# Banco (o compose monta o DATABASE_URL a partir desta senha): openssl rand -hex 24
POSTGRES_PASSWORD=

# Domínio do app (front em /, API em /api), apontando para o IP da VPS; o Caddy gera o HTTPS
API_DOMAIN=nutriai.duckdns.org

# Sessão: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth. O compose monta o resto a partir do API_DOMAIN: registre no Google Cloud Console
# a origem https://<API_DOMAIN> e o callback https://<API_DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# openssl rand -base64 32 (não troque depois: os tokens do Google já gravados ficariam ilegíveis)
TOKEN_ENCRYPTION_KEY=

HEALTH_SYNC_CRON=0 3 * * *
HEALTH_SYNC_TIMEZONE=America/Sao_Paulo

ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
