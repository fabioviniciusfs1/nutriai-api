# O front (Next.js) usa a 3000 em dev
PORT=3001

# Banco (docker compose up -d)
DATABASE_URL=postgres://nutriai:nutriai@localhost:5433/nutriai

# Sessão
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=7d

# Origens do front, separadas por vírgula (CORS e redirect_uri do login com Google)
FRONTEND_URLS=http://localhost:3000

# Google OAuth (Google Cloud Console → credenciais OAuth "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback deste backend, registrado no Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# 32 bytes em base64 (openssl rand -base64 32): criptografa o refresh token do Google
TOKEN_ENCRYPTION_KEY=

# Sincronização agendada com a Google Health API (cron; "off" desliga) e o fuso do horário
HEALTH_SYNC_CRON=0 3 * * *
HEALTH_SYNC_TIMEZONE=America/Sao_Paulo

# Chat (API da Anthropic)
ANTHROPIC_API_KEY=
# Só para chaves de usuário (sem workspace): ID do workspace (Console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=

# @nestjs/observe
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
